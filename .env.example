RAG_DATA_DIR=data/semantic-index
RAG_EMBEDDING_BACKEND=sentence-transformer
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_DEVICE=cpu
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_MAX_FILE_MB=25
RAG_MAX_PAGES=500
RAG_RETRIEVAL_DEPTH=30
RAG_RRF_K=60
RAG_RERANKER_BACKEND=cross-encoder
RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_OLLAMA_URL=http://localhost:11434
RAG_OLLAMA_MODEL=qwen3:1.7b
# Optional ordinary Arabic answer translator; defaults to RAG_OLLAMA_MODEL.
# RAG_TRANSLATION_MODEL=your-installed-local-model
RAG_API_URL=http://localhost:8000
HF_HOME=.cache/huggingface
RAG_BM25_CASEFOLD=true
RAG_LLM_TIMEOUT=120
RAG_LLM_TOTAL_TIMEOUT=150
RAG_LLM_CONTEXT_TOKENS=8192
RAG_MAX_ANSWER_STATEMENTS=4
RAG_MAX_CONTEXT_CHARS=8000

# Experimental model-based coverage gate; may falsely reject correct answers.
RAG_QUESTION_COVERAGE_AUDIT=false
